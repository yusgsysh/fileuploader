# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
DATA_DIR=/app/data
DATABASE_URL=sqlite:///app/data/fileuploader.db
STATIC_DIR=/app/static
LOG_FORMAT=pretty
RUST_LOG=info,aws_config=warn,aws_smithy_runtime=warn,hyper=warn
TZ=UTC

# Optional HTTP Basic Auth as an extra layer in front of the built-in login
# page. Set both or neither. When enabled, Basic credentials also count as a
# valid login and the first-run admin setup is skipped.
# /healthz remains unauthenticated for container health checks.
APP_BASIC_AUTH_USERNAME=
APP_BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Optional first-run S3 configuration
# The same configuration can be created later in the Web UI.
# ---------------------------------------------------------------------------
SEED_DEFAULT_S3=true
S3_CONFIG_ID=default
S3_CONFIG_NAME=Cloudflare R2
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_DEFAULT_PREFIX=
S3_PATH_STYLE=true
S3_USE_TLS=true

# Generic S3 / MinIO example:
# S3_ENDPOINT=https://minio.example.com
# S3_REGION=us-east-1
# S3_PATH_STYLE=true

# AWS S3 example:
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_PATH_STYLE=false

# ---------------------------------------------------------------------------
# MEGAcmd
# ---------------------------------------------------------------------------
MEGA_HOME=/app/data/mega-home
MEGA_TEMP_DIR=/app/tmp/mega
MEGA_AUTO_START_SERVER=true
MEGA_GET_PATH=mega-get
MEGA_SERVER_PATH=mega-cmd-server
MEGA_WHOAMI_PATH=mega-whoami

# ---------------------------------------------------------------------------
# Transfer defaults (also editable in Settings)
# ---------------------------------------------------------------------------
PART_SIZE_BYTES=16777216
UPLOAD_CONCURRENCY=2
HTTP_BUFFER_BYTES=1048576
MAX_PENDING_PARTS=2
MAX_HTTP_TASKS=3
MAX_MEGA_TASKS=1
MAX_QUEUED_TASKS=50
MAX_RETRIES=3
HTTP_TIMEOUT_SECS=30
MAX_REDIRECTS=10
MAX_FILE_BYTES=107374182400
TASK_TIMEOUT_SECS=86400

MEGA_MAX_TASK_BYTES=53687091200
MEGA_TEMP_MAX_BYTES=214748364800
MEGA_RETENTION_SECS=86400
MEGA_MAX_DOWNLOADS=1
MEGA_DOWNLOAD_TIMEOUT_SECS=21600
